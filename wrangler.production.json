{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airapvideo",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://ai-rap-video.me",
    "VITE_APP_NAME": "airapvideo",
    "VITE_APP_DESCRIPTION": "AI rap music video generator and short video creation service",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airapvideo",
      "database_id": "26877214-d2e3-486a-a2e6-515dc89d2461",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "routes": [{ "pattern": "ai-rap-video.me", "custom_domain": true }]
}
